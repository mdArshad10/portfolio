{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/projects/:id", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
